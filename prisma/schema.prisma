generator client {
  provider = "prisma-client-js"

  // O segundo alvo e o servidor da Netlify (Amazon Linux). Sem ele, o sistema
  // sobe mas reclama de "binario nao encontrado" depois de publicado.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"

  // Endereco normal do banco (o "pooler" do Supabase, porta 6543).
  url = env("DATABASE_URL")

  // Endereco direto (porta 5432). So e usado para criar/atualizar as tabelas.
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Pessoas da equipe
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String // ADMIN | EDICAO | SOCIAL | TRAFEGO | DESIGN | COPY | FILMAGEM
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  demands  Demand[]  @relation("Responsavel")
  goals    Goal[]
  comments Comment[]
  agendas  Agenda[]  @relation("AgendaCriadaPor")
  progress LessonProgress[]
  quiz     QuizResult?
}

// ---------------------------------------------------------------------------
// Clientes e contratos
// ---------------------------------------------------------------------------

model Client {
  id          String   @id @default(cuid())
  name        String
  company     String?
  contactName String?
  email       String?
  phone       String?
  startDate   DateTime // cliente desde
  status      String   @default("ATIVO") // ATIVO | PAUSADO | ENCERRADO
  monthlyFee  Float? // quanto o cliente paga por mes (opcional; substitui a soma dos contratos)
  notes       String?
  createdAt   DateTime @default(now())

  contracts   Contract[]
  demands     Demand[]
  receivables Receivable[]
  payables    Payable[]
  agendas     Agenda[]
}

model Contract {
  id           String    @id @default(cuid())
  clientId     String
  title        String
  monthlyValue Float
  startDate    DateTime
  endDate      DateTime?
  status       String    @default("ATIVO") // ATIVO | ENCERRADO
  // Link do contrato assinado (Drive, Docs, PDF em nuvem).
  pdfUrl       String?
  notes        String?
  createdAt    DateTime  @default(now())

  client      Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  receivables Receivable[]
}

// ---------------------------------------------------------------------------
// Demandas (usadas na lista e no kanban)
// ---------------------------------------------------------------------------

model Demand {
  id          String    @id @default(cuid())
  title       String
  description String?
  clientId    String?
  area        String // EDICAO | SOCIAL | TRAFEGO | DESIGN | COPY | FILMAGEM
  assigneeId  String?
  status      String    @default("A_FAZER") // BACKLOG | A_FAZER | EM_ANDAMENTO | REVISAO | CONCLUIDO
  priority    String    @default("MEDIA") // BAIXA | MEDIA | ALTA
  // Prazo que a equipe combinou internamente (data-alvo interna, antes do cliente).
  internalDueDate DateTime?
  // Prazo que foi combinado com o cliente (data-alvo externa).
  dueDate     DateTime?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())

  client      Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  assignee    User?        @relation("Responsavel", fields: [assigneeId], references: [id], onDelete: SetNull)
  comments    Comment[]
  attachments Attachment[]
}

/// Conversa dentro da demanda: combinados, ajustes, avisos.
model Comment {
  id        String   @id @default(cuid())
  demandId  String
  authorId  String?
  text      String
  createdAt DateTime @default(now())

  demand Demand @relation(fields: [demandId], references: [id], onDelete: Cascade)
  author User?  @relation(fields: [authorId], references: [id], onDelete: SetNull)
}

/// Link do material: drive, briefing, arte aprovada.
model Attachment {
  id        String   @id @default(cuid())
  demandId  String
  title     String
  url       String
  createdAt DateTime @default(now())

  demand Demand @relation(fields: [demandId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Financeiro
// ---------------------------------------------------------------------------

model Payable {
  id          String    @id @default(cuid())
  description String
  supplier    String?
  category    String? // Ex.: Software, Equipe, Impostos
  amount      Float
  dueDate     DateTime
  status      String    @default("PENDENTE") // PENDENTE | PAGO
  paidAt      DateTime?
  createdAt   DateTime  @default(now())

  /// Quando o gasto e de um cliente especifico (freela, diaria, impulsionamento),
  /// aponta para ele. E assim que o relatorio calcula o que sobra por cliente.
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  /// Id do lancamento no Cora quando esta conta veio do extrato dele.
  /// Usado para nao importar duas vezes o mesmo debito.
  coraEntryId String? @unique
}

model Receivable {
  id          String    @id @default(cuid())
  description String
  clientId    String?
  contractId  String?
  amount      Float
  dueDate     DateTime
  status      String    @default("PENDENTE") // PENDENTE | RECEBIDO
  receivedAt  DateTime?
  createdAt   DateTime  @default(now())

  client   Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  contract Contract? @relation(fields: [contractId], references: [id], onDelete: SetNull)

  /// Id do lancamento no Cora quando este recebido veio do extrato dele.
  coraEntryId String? @unique
}

// Chave/valor para pequenas configuracoes do sistema (ex.: quando foi a
// ultima sincronizacao com o Cora, para saber por onde continuar).
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Agenda do calendario
// ---------------------------------------------------------------------------

/// Compromisso marcado direto no calendario: gravacao, post, reuniao, entrega.
/// Diferente da demanda (que e trabalho a fazer), isto e "o que acontece no dia".
model Agenda {
  id          String   @id @default(cuid())
  title       String
  type        String   @default("OUTRO") // GRAVACAO | POST | REUNIAO | ENTREGA | OUTRO
  date        DateTime // dia do compromisso
  time        String? // hora no formato "14:30", opcional
  clientId    String?
  notes       String?
  createdById String?
  createdAt   DateTime @default(now())

  client    Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdBy User?   @relation("AgendaCriadaPor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([date])
}

// ---------------------------------------------------------------------------
// Metas e objetivos do mes
// ---------------------------------------------------------------------------

model Goal {
  id           String   @id @default(cuid())
  title        String
  description  String?
  scope        String   @default("PESSOAL") // PESSOAL | EQUIPE | AGENCIA
  ownerId      String?
  area         String?
  month        Int
  year         Int
  targetValue  Float    @default(1)
  currentValue Float    @default(0)
  unit         String   @default("un") // un | R$ | %
  createdAt    DateTime @default(now())

  owner User? @relation(fields: [ownerId], references: [id], onDelete: SetNull)
}

// ---------------------------------------------------------------------------
// Cursos da Move
//
// Trilha  = caminho de estudo (Posicionamento, Conteudo, Trafego...).
// Curso   = o que aparece na vitrine, dividido em modulos.
// Modulo  = um bloco do curso, com nivel proprio - e por isso que o quiz
//           consegue dizer nao so QUAL curso, mas por ONDE comecar.
// Aula    = o video em si.
// ---------------------------------------------------------------------------

/// Caminho de estudo. Um curso pode servir a mais de uma trilha.
model Track {
  id          String   @id @default(cuid())
  slug        String   @unique // usado pelo quiz: posicionamento, conteudo...
  name        String
  tagline     String?
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  courses     CourseTrack[]
  quizResults QuizResult[]
}

model Course {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  subtitle    String?
  description String?
  level       String   @default("INICIANTE") // INICIANTE | INTERMEDIARIO | AVANCADO
  area        String? // EDICAO | SOCIAL | TRAFEGO | DESIGN | COPY | FILMAGEM
  cover       String   @default("laranja") // cor da capa na vitrine
  featured    Boolean  @default(false) // aparece no destaque grande do topo
  published   Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  tracks  CourseTrack[]
  modules CourseModule[]
}

/// Liga curso e trilha. O mesmo curso de fundamentos serve a varias trilhas.
model CourseTrack {
  courseId String
  trackId  String
  order    Int    @default(0)

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  track  Track  @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@id([courseId, trackId])
}

model CourseModule {
  id          String  @id @default(cuid())
  courseId    String
  title       String
  description String?
  /// Nivel deste bloco. E o que o quiz usa para dizer por onde a pessoa entra.
  level       String  @default("INICIANTE")
  order       Int     @default(0)

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]
}

model Lesson {
  id          String   @id @default(cuid())
  moduleId    String
  title       String
  description String?
  /// Link do YouTube ou Vimeo. Vazio = aula ainda sem video publicado.
  videoUrl    String?
  /// Material de apoio (PDF, planilha, Drive).
  materialUrl String?
  durationMin Int      @default(0)
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  module   CourseModule     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress LessonProgress[]
}

/// Quem ja assistiu o que. Uma linha por pessoa e aula.
model LessonProgress {
  id        String   @id @default(cuid())
  userId    String
  lessonId  String
  completed Boolean  @default(false)
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

/// Resultado do quiz: a trilha indicada e o nivel de entrada da pessoa.
model QuizResult {
  id        String   @id @default(cuid())
  userId    String   @unique
  trackId   String?
  level     String   @default("INICIANTE")
  /// Respostas e pontuacao guardadas em JSON, para refazer e para auditar.
  answers   String   @default("{}")
  scores    String   @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  track Track? @relation(fields: [trackId], references: [id], onDelete: SetNull)
}
