generator client {
  provider = "prisma-client-js"

  // O segundo alvo e o servidor da Netlify (Amazon Linux). Sem ele, o sistema
  // sobe mas reclama de "binario nao encontrado" depois de publicado.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"

  // Endereco normal do banco (o "pooler" do Supabase, porta 6543).
  url = env("DATABASE_URL")

  // Endereco direto (porta 5432). So e usado para criar/atualizar as tabelas.
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Pessoas da equipe
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String // ADMIN | EDICAO | SOCIAL | TRAFEGO | DESIGN | COPY | FILMAGEM
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  demands  Demand[]  @relation("Responsavel")
  goals    Goal[]
  comments Comment[]
}

// ---------------------------------------------------------------------------
// Clientes e contratos
// ---------------------------------------------------------------------------

model Client {
  id          String   @id @default(cuid())
  name        String
  company     String?
  contactName String?
  email       String?
  phone       String?
  startDate   DateTime // cliente desde
  status      String   @default("ATIVO") // ATIVO | PAUSADO | ENCERRADO
  monthlyFee  Float? // quanto o cliente paga por mes (opcional; substitui a soma dos contratos)
  notes       String?
  createdAt   DateTime @default(now())

  contracts   Contract[]
  demands     Demand[]
  receivables Receivable[]
  payables    Payable[]
}

model Contract {
  id           String    @id @default(cuid())
  clientId     String
  title        String
  monthlyValue Float
  startDate    DateTime
  endDate      DateTime?
  status       String    @default("ATIVO") // ATIVO | ENCERRADO
  // Link do contrato assinado (Drive, Docs, PDF em nuvem).
  pdfUrl       String?
  notes        String?
  createdAt    DateTime  @default(now())

  client      Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  receivables Receivable[]
}

// ---------------------------------------------------------------------------
// Demandas (usadas na lista e no kanban)
// ---------------------------------------------------------------------------

model Demand {
  id          String    @id @default(cuid())
  title       String
  description String?
  clientId    String?
  area        String // EDICAO | SOCIAL | TRAFEGO | DESIGN | COPY | FILMAGEM
  assigneeId  String?
  status      String    @default("A_FAZER") // BACKLOG | A_FAZER | EM_ANDAMENTO | REVISAO | CONCLUIDO
  priority    String    @default("MEDIA") // BAIXA | MEDIA | ALTA
  // Prazo que a equipe combinou internamente (data-alvo interna, antes do cliente).
  internalDueDate DateTime?
  // Prazo que foi combinado com o cliente (data-alvo externa).
  dueDate     DateTime?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())

  client      Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  assignee    User?        @relation("Responsavel", fields: [assigneeId], references: [id], onDelete: SetNull)
  comments    Comment[]
  attachments Attachment[]
}

/// Conversa dentro da demanda: combinados, ajustes, avisos.
model Comment {
  id        String   @id @default(cuid())
  demandId  String
  authorId  String?
  text      String
  createdAt DateTime @default(now())

  demand Demand @relation(fields: [demandId], references: [id], onDelete: Cascade)
  author User?  @relation(fields: [authorId], references: [id], onDelete: SetNull)
}

/// Link do material: drive, briefing, arte aprovada.
model Attachment {
  id        String   @id @default(cuid())
  demandId  String
  title     String
  url       String
  createdAt DateTime @default(now())

  demand Demand @relation(fields: [demandId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Financeiro
// ---------------------------------------------------------------------------

model Payable {
  id          String    @id @default(cuid())
  description String
  supplier    String?
  category    String? // Ex.: Software, Equipe, Impostos
  amount      Float
  dueDate     DateTime
  status      String    @default("PENDENTE") // PENDENTE | PAGO
  paidAt      DateTime?
  createdAt   DateTime  @default(now())

  /// Quando o gasto e de um cliente especifico (freela, diaria, impulsionamento),
  /// aponta para ele. E assim que o relatorio calcula o que sobra por cliente.
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  /// Id do lancamento no Cora quando esta conta veio do extrato dele.
  /// Usado para nao importar duas vezes o mesmo debito.
  coraEntryId String? @unique
}

model Receivable {
  id          String    @id @default(cuid())
  description String
  clientId    String?
  contractId  String?
  amount      Float
  dueDate     DateTime
  status      String    @default("PENDENTE") // PENDENTE | RECEBIDO
  receivedAt  DateTime?
  createdAt   DateTime  @default(now())

  client   Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  contract Contract? @relation(fields: [contractId], references: [id], onDelete: SetNull)

  /// Id do lancamento no Cora quando este recebido veio do extrato dele.
  coraEntryId String? @unique
}

// Chave/valor para pequenas configuracoes do sistema (ex.: quando foi a
// ultima sincronizacao com o Cora, para saber por onde continuar).
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Metas e objetivos do mes
// ---------------------------------------------------------------------------

model Goal {
  id           String   @id @default(cuid())
  title        String
  description  String?
  scope        String   @default("PESSOAL") // PESSOAL | EQUIPE | AGENCIA
  ownerId      String?
  area         String?
  month        Int
  year         Int
  targetValue  Float    @default(1)
  currentValue Float    @default(0)
  unit         String   @default("un") // un | R$ | %
  createdAt    DateTime @default(now())

  owner User? @relation(fields: [ownerId], references: [id], onDelete: SetNull)
}
