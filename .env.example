# Modelo do arquivo de configuração.
#
# Copie este arquivo para ".env" e preencha com os seus valores.
# O arquivo ".env" nunca vai para o GitHub — ele guarda suas senhas.

# ---------------------------------------------------------------------------
# Banco de dados (Supabase)
# ---------------------------------------------------------------------------
# No painel do Supabase: Project Settings > Database > Connection string.
#
# DATABASE_URL  = a opção "Transaction pooler"  (porta 6543)
# DIRECT_URL    = a opção "Direct connection"   (porta 5432)
#
# Nas duas, troque [YOUR-PASSWORD] pela senha do banco que você criou.

DATABASE_URL="postgresql://postgres.abcdefgh:SUA-SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.abcdefgh:SUA-SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------------------
# Segurança
# ---------------------------------------------------------------------------
# Chave que assina o login. Gere uma sua com o comando:
#   openssl rand -hex 32
SESSION_SECRET="troque-por-uma-chave-aleatoria-e-secreta"

# ---------------------------------------------------------------------------
# Tela ao vivo (opcional)
# ---------------------------------------------------------------------------
# Fazem a tela de todo mundo se atualizar na hora, sem F5.
# No painel do Supabase: Settings > API Keys.
#
# A chave publica pode aparecer como "Publishable key" (sb_publishable_...)
# ou como "anon public" — as duas funcionam aqui.
#
# Sem estes dois valores o sistema continua funcionando: ele passa a
# procurar novidades a cada poucos segundos, em vez de instantaneamente.

NEXT_PUBLIC_SUPABASE_URL="https://abcdefgh.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="a-chave-publica-anon-do-seu-projeto"

# ---------------------------------------------------------------------------
# Cora (opcional — traz o extrato bancário para dentro do sistema)
# ---------------------------------------------------------------------------
# No painel do Cora: Integrações > Conexão API > gere um par novo.
# Cole os três valores abaixo. A chave privada é o "cofre" da conta —
# só deve viver aqui e nas variáveis da Netlify, nunca em outro lugar.

CORA_CLIENT_ID=""
CORA_CERT_PEM=""
CORA_KEY_PEM=""

# ---------------------------------------------------------------------------
# Arquivos nas demandas (opcional — PDF, imagem, planilha)
# ---------------------------------------------------------------------------
# No painel do Supabase: Project Settings > API Keys > chave secreta
# ("Secret key" sb_secret_... ou "service_role"). Nunca coloque no GitHub.
# Sem ela, as demandas continuam aceitando links normalmente.

SUPABASE_SERVICE_ROLE_KEY=""

# ---------------------------------------------------------------------------
# E-mail avisando de demanda nova (opcional)
# ---------------------------------------------------------------------------
# Chave do Resend (resend.com > API Keys) e quem aparece como remetente.
# O remetente precisa usar um dominio confirmado no Resend.
# SITE_URL e o endereco do sistema, para o link do e-mail (na Netlify ja vem
# sozinho; so precisa preencher se usar dominio proprio).

RESEND_API_KEY=""
EMAIL_REMETENTE="Sistema Move <avisos@seudominio.com.br>"
SITE_URL=""
